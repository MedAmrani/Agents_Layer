<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:ctyp="http://www.filenet.com/wsi/types/"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Fragment insere dans soapenv:Body : PAS de declaration XML -->
  <xsl:output method="xml" indent="yes" encoding="UTF-8" omit-xml-declaration="yes"/>

  <xsl:template match="/Root/Document">

    <!-- ALL_VERSIONS  : on cible la VersionSeries  -> toutes les versions partent
         SINGLE_VERSION: on cible le Document       -> seule cette version part -->
    <xsl:variable name="targetClass">
      <xsl:choose>
        <xsl:when test="deleteMode = 'ALL_VERSIONS'">VersionSeries</xsl:when>
        <xsl:otherwise><xsl:value-of select="docClass"/></xsl:otherwise>
      </xsl:choose>
    </xsl:variable>

    <xsl:variable name="targetId">
      <xsl:choose>
        <xsl:when test="deleteMode = 'ALL_VERSIONS'"><xsl:value-of select="versionSeriesId"/></xsl:when>
        <xsl:otherwise><xsl:value-of select="documentId"/></xsl:otherwise>
      </xsl:choose>
    </xsl:variable>

    <!-- refresh=false : une suppression ne renvoie aucun objet a rafraichir -->
    <ctyp:ExecuteChangesRequest refresh="false">
      <ctyp:ChangeRequest id="{sortld}">

        <!-- La cible est l'objet LUI-MEME, pas l'object store -->
        <ctyp:TargetSpecification xsi:type="ctyp:ObjectReference"
                                  objectStore="{OsName}"
                                  classId="{$targetClass}"
                                  objectId="{$targetId}"/>

        <ctyp:Action xsi:type="ctyp:DeleteAction"/>

      </ctyp:ChangeRequest>
    </ctyp:ExecuteChangesRequest>
  </xsl:template>
</xsl:stylesheet>
