<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:ctyp="http://www.filenet.com/wsi/types/"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Fragment insere dans soapenv:Body : pas de declaration XML -->
  <xsl:output method="xml" indent="yes" encoding="UTF-8" omit-xml-declaration="yes"/>

  <xsl:template match="/Root/Document">

    <!-- Taille reelle du fichier decode, calculee depuis la chaine base64 -->
    <xsl:variable name="b64" select="translate(fileBase64, '&#10;&#13;&#9; ', '')"/>
    <xsl:variable name="pad"
      select="string-length(translate(substring($b64, string-length($b64) - 1, 2),
              'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/', ''))"/>
    <xsl:variable name="decodedSize" select="string-length($b64) div 4 * 3 - $pad"/>

    <ctyp:ExecuteChangesRequest refresh="true">
      <ctyp:ChangeRequest id="{sortld}">

        <ctyp:TargetSpecification xsi:type="ctyp:ObjectStoreSpecification" objectStore="{OsName}"/>

        <ctyp:Action xsi:type="ctyp:CreateAction" classId="{classDoc}"
                     autoUniqueContainmentName="true" defineSecurityParentage="1"/>
        <ctyp:Action xsi:type="ctyp:CheckinAction" autoClassify="false" checkinMinorVersion="false"/>

        <ctyp:ActionProperties>

          <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="DocumentTitle">
            <ctyp:Value><xsl:value-of select="fileName"/></ctyp:Value>
          </ctyp:Property>

          <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="MimeType">
            <ctyp:Value><xsl:value-of select="mimeType"/></ctyp:Value>
          </ctyp:Property>

          <!-- Une Property par entree de metadata, quel que soit leur nombre -->
          <xsl:for-each select="metadatas/metadata">
          <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="{keyName}">
            <ctyp:Value><xsl:value-of select="keyValue"/></ctyp:Value>
          </ctyp:Property>
          </xsl:for-each>

          <ctyp:Property xsi:type="ctyp:ListOfObject" propertyId="ContentElements" listMode="Replace">
            <ctyp:Value classId="ContentTransfer" dependentAction="Insert">

              <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="RetrievalName">
                <ctyp:Value><xsl:value-of select="fileName"/></ctyp:Value>
              </ctyp:Property>

              <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="ContentType">
                <ctyp:Value><xsl:value-of select="mimeType"/></ctyp:Value>
              </ctyp:Property>

              <ctyp:Property xsi:type="ctyp:ContentData" propertyId="Content">
                <ctyp:Value xsi:type="ctyp:InlineContent" size="{$decodedSize}">
                  <ctyp:Binary><xsl:value-of select="$b64"/></ctyp:Binary>
                </ctyp:Value>
              </ctyp:Property>

            </ctyp:Value>
          </ctyp:Property>

        </ctyp:ActionProperties>
      </ctyp:ChangeRequest>
    </ctyp:ExecuteChangesRequest>
  </xsl:template>
</xsl:stylesheet>
