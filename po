<?xml version="1.0" encoding="UTF-8"?>
<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"
                   xmlns:ctyp="http://www.filenet.com/wsi/types/"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <soapenv:Header>
    <wsse:Security soapenv:mustUnderstand="1"
                    xmlns:wsse="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd"
                    xmlns:wsu="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd">
      <wsu:Timestamp wsu:Id="TS-1">
        <wsu:Created>${wsu.created}</wsu:Created>
        <wsu:Expires>${wsu.expires}</wsu:Expires>
      </wsu:Timestamp>
      <wsse:UsernameToken>
        <wsse:Username>${filenet.username}</wsse:Username>
        <wsse:Password Type="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-username-token-profile-1.0#PasswordText">${filenet.password}</wsse:Password>
        <wsse:Nonce EncodingType="http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-soap-message-security-1.0#Base64Binary">${wsu.nonce}</wsse:Nonce>
        <wsu:Created>${wsu.created}</wsu:Created>
      </wsse:UsernameToken>
    </wsse:Security>
  </soapenv:Header>
  <soapenv:Body>
    <ctyp:GetObjectsRequest>
      <ctyp:ObjectRequest id="1">
        <ctyp:SourceSpecification xsi:type="ctyp:ObjectSpecification"
                                   objectStore="${OsName}"
                                   classId="Folder"
                                   path="${folderPath:escapeXml()}"/>
        <ctyp:PropertyFilter maxRecursion="0">
          <ctyp:IncludeProperties value="Id Name PathName"/>
        </ctyp:PropertyFilter>
      </ctyp:ObjectRequest>
    </ctyp:GetObjectsRequest>
  </soapenv:Body>
</soapenv:Envelope>
