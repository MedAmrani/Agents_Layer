/*
 * NiFi ExecuteGroovyScript: replaces InvokeHTTP.
 * Sends the FlowFile content (an already prepared multipart body) as a POST,
 * with an OAuth2 token taken from an existing controller service.
 *
 * Processor setup (dynamic properties, added with "+"):
 *   CTL.oauth  -> select the controller service "kokooauth2"
 *   apiKey     -> #{api_key}   (or the literal key)
 *
 * Input FlowFile (e.g. from GenerateFlowFile):
 *   content = the full multipart body, starting with the line "--<boundary>"
 *
 * The boundary is read from the first line of the content.
 * The API response body replaces the FlowFile content.
 */
import org.apache.nifi.processor.io.OutputStreamCallback

def ff = session.get()
if (!ff) return

// ---- settings -------------------------------------------------------------
def url     = 'https://heellowworl.com/lo'
def fixCrlf = true   // convert line endings to \r\n, as multipart requires
// ---------------------------------------------------------------------------

try {
    // Read the prepared body from the FlowFile
    def buffer = new ByteArrayOutputStream()
    session.exportTo(ff, buffer)
    def text = buffer.toString('UTF-8')

    // Boundary = first non-empty line, without the leading "--"
    def firstLine = text.readLines().find { it.trim() }?.trim()
    if (!firstLine?.startsWith('--')) {
        throw new IllegalStateException('Content must start with a "--<boundary>" line')
    }
    def boundary = firstLine.substring(2)

    if (fixCrlf) {
        text = text.replaceAll(/\r?\n/, '\r\n')
        if (!text.endsWith('\r\n')) text += '\r\n'
    }
    byte[] payload = text.getBytes('UTF-8')

    // Token from the controller service (it handles caching and refresh)
    def token = CTL.oauth.getAccessDetails().getAccessToken()
    def key   = apiKey.evaluateAttributeExpressions(ff).value

    // Send it
    def conn = (HttpURLConnection) new URL(url).openConnection()
    conn.requestMethod  = 'POST'
    conn.doOutput       = true
    conn.connectTimeout = 15000
    conn.readTimeout    = 60000
    conn.setFixedLengthStreamingMode(payload.length)
    conn.setRequestProperty('Authorization', "Bearer ${token}")
    conn.setRequestProperty('Content-Type', "multipart/form-data; boundary=${boundary}")
    conn.setRequestProperty('X-BOBO', 'PPLLII')
    conn.setRequestProperty('apiKey', key)
    conn.outputStream.withStream { it.write(payload) }

    // Read the response
    int status = conn.responseCode
    def stream = status < 400 ? conn.inputStream : conn.errorStream
    byte[] response = stream ? stream.bytes : new byte[0]
    conn.disconnect()

    ff = session.write(ff, { out -> out.write(response) } as OutputStreamCallback)
    ff = session.putAttribute(ff, 'http.status.code', String.valueOf(status))
    session.transfer(ff, (status >= 200 && status < 300) ? REL_SUCCESS : REL_FAILURE)

} catch (Exception e) {
    log.error('Multipart POST failed', e)
    ff = session.putAttribute(ff, 'error.message', e.toString())
    session.transfer(ff, REL_FAILURE)
}
