import org.apache.nifi.processor.io.StreamCallback
import java.nio.charset.StandardCharsets

def flowFile = session.get()
if (!flowFile) return

try {
    flowFile = session.write(flowFile, { InputStream inp, OutputStream out ->
        String html = inp.getText('UTF-8')

        // 1. Go directly to the table
        def table = (html =~ /(?is)<table\b.*?<\/table>/)
        if (!table.find()) throw new Exception("No <table> found")
        String tableHtml = table.group()

        def writer = new OutputStreamWriter(out, StandardCharsets.UTF_8)

        // 2. Each row
        (tableHtml =~ /(?is)<tr\b[^>]*>(.*?)<\/tr>/).each { rowMatch ->
            String row = rowMatch[1]

            // 3. Each cell -> clean text -> CSV value
            def cells = (row =~ /(?is)<t[dh]\b[^>]*>(.*?)<\/t[dh]>/).collect { cellMatch ->
                String text = cellMatch[1]
                    .replaceAll(/<[^>]*>/, '')      // remove inner tags
                    .replace('&nbsp;', ' ')
                    .replace('&lt;', '<')
                    .replace('&gt;', '>')
                    .replace('&quot;', '"')
                    .replace('&amp;', '&')
                    .replaceAll(/\s+/, ' ')
                    .trim()
                '"' + text.replace('"', '""') + '"'
            }

            // 4. Write the CSV line
            if (cells) writer.write(cells.join(',') + '\n')
        }
        writer.flush()
    } as StreamCallback)

    flowFile = session.putAttribute(flowFile, 'filename',
        flowFile.getAttribute('filename').replaceAll(/(?i)\.xls$/, '') + '.csv')
    session.transfer(flowFile, REL_SUCCESS)
} catch (Exception e) {
    log.error("HTML to CSV failed", e)
    session.transfer(flowFile, REL_FAILURE)
}
