<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:ctyp="http://www.filenet.com/wsi/types/"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Fragment insere dans soapenv:Body : PAS de declaration XML -->
  <xsl:output method="xml" indent="yes" encoding="UTF-8" omit-xml-declaration="yes"/>

  <xsl:template match="/Root/Folder">
    <ctyp:ExecuteChangesRequest refresh="true">
      <ctyp:ChangeRequest id="{sortld}">

        <ctyp:TargetSpecification xsi:type="ctyp:ObjectStoreSpecification" objectStore="{OsName}"/>

        <!-- Un dossier n'est pas versionne : pas de CheckinAction -->
        <ctyp:Action xsi:type="ctyp:CreateAction" classId="{folderClass}"/>

        <ctyp:ActionProperties>

          <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="FolderName">
            <ctyp:Value><xsl:value-of select="folderName"/></ctyp:Value>
          </ctyp:Property>

          <!-- La hierarchie passe par la propriete Parent : aucun RCR necessaire -->
          <ctyp:Property xsi:type="ctyp:SingletonObject" propertyId="Parent">
            <ctyp:Value xsi:type="ctyp:ObjectReference"
                        objectStore="{OsName}"
                        classId="Folder"
                        objectId="{parentId}"/>
          </ctyp:Property>

          <!-- Une Property par entree de metadata, quel que soit leur nombre (0 inclus) -->
          <xsl:for-each select="metadatas/metadata">
          <ctyp:Property xsi:type="ctyp:SingletonString" propertyId="{keyName}">
            <ctyp:Value><xsl:value-of select="keyValue"/></ctyp:Value>
          </ctyp:Property>
          </xsl:for-each>

        </ctyp:ActionProperties>
      </ctyp:ChangeRequest>
    </ctyp:ExecuteChangesRequest>
  </xsl:template>
</xsl:stylesheet>
